{
  "name": "spho-exam-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "npm run build:qa && playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fixtures": "node scripts/fixtures.mjs",
    "build:qa": "cargo build --manifest-path src-tauri/Cargo.toml --features qa --bin spho-qa",
    "format": "prettier --write src e2e scripts/*.ts *.json *.ts *.md schema src-tauri/tauri.conf.json src-tauri/capabilities && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src e2e scripts/*.ts *.json *.ts *.md schema src-tauri/tauri.conf.json src-tauri/capabilities && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "katex": "$katex"
  }
}
