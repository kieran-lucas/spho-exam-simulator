{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 500,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "section": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "topic": {
        "type": "string",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "stem": {
        "minItems": 1,
        "maxItems": 200,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "markdown"
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                }
              },
              "required": ["type", "content"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "image"
                },
                "src": {
                  "type": "string"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": ["type", "src", "alt", "caption"],
              "additionalProperties": false
            }
          ]
        }
      },
      "choices": {
        "minItems": 4,
        "maxItems": 4,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "enum": ["A", "B", "C", "D"]
            },
            "content": {
              "minItems": 1,
              "maxItems": 200,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "markdown"
                      },
                      "content": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100000
                      }
                    },
                    "required": ["type", "content"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "image"
                      },
                      "src": {
                        "type": "string"
                      },
                      "alt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "caption": {
                        "default": "",
                        "type": "string"
                      }
                    },
                    "required": ["type", "src", "alt", "caption"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": ["key", "content"],
          "additionalProperties": false
        }
      }
    },
    "required": ["id", "section", "topic", "tags", "stem", "choices"],
    "additionalProperties": false
  },
  "$id": "https://spho.local/schema/questions.schema.json",
  "title": "spho-exam/1.0 questions"
}
